# Variables de entorno para EON
# Copia este archivo a .env y ajusta los valores

# ─── Proveedor LLM ──────────────────────────────────────────
# Uno de: claude, openai, gemini, ollama, groq, openrouter, fallback
EON_LLM_PROVIDER=claude

# ─── API Keys (solo la del provider que uses) ───────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─── Ollama (local, sin API key) ────────────────────────────
# EON_OLLAMA_URL=http://localhost:11434
# EON_OLLAMA_MODEL=llama3

# ─── Consola ────────────────────────────────────────────────
# EON_CONSOLE_HOST=127.0.0.1
# EON_CONSOLE_PORT=8765
# EON_CONSOLE_ROOT=/data

# ─── Memoria ────────────────────────────────────────────────
# EON_MEMORY_PATH=.eon_runtime/memory

# ─── Plugins ────────────────────────────────────────────────
# Directorio donde buscar plugins de Tools custom
# EON_PLUGINS_DIR=plugins/

# ─── SMTP (EmailTool) ───────────────────────────────────────
# EON_SMTP_HOST=smtp.gmail.com
# EON_SMTP_PORT=587
# EON_SMTP_USER=
# EON_SMTP_PASSWORD=
# EON_SMTP_FROM=

# ─── Google Calendar (CalendarTool) ──────────────────────────
# EON_GOOGLE_CREDENTIALS_PATH=/data/google-credentials.json
